{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs"
    },
    "api": {
      "root": "apps/api",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "web",
          "format": "url",
          "env": "WEB_INTERNAL_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/.well-known/workflow/v1/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/webhooks/commercetools",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/api/commerce/order-events",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
