{
  "$schema": "../../node_modules/@effect/tsgo/schema.json",
  "extends": "@repo/typescript-config/effect-nextjs.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "noUnusedLocals": true,
    "plugins": [
      {
        "name": "gql.tada/ts-plugin",
        "schema": "./gql/schema.graphql",
        "tadaOutputLocation": "./gql/graphql-env.d.ts",
        "tadaTurboLocation": "./gql/graphql-cache.d.ts"
      },
      {
        "name": "@effect/language-service",
        "diagnostics": false,
        "includeSuggestionsInTsc": false
      }
    ],
    "paths": {
      "@repo/commerce-commercetools/*": ["./*"],
      "@repo/commerce-core/*": ["../commerce-core/*"],
      "@repo/*": ["../*"]
    },
    "declaration": false,
    "declarationMap": false
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules", "checkout/registry", "**/*.template.*"]
}
