# Commercetools Configuration
COMMERCETOOLS_PROJECT_KEY=your-project-key
COMMERCETOOLS_CLIENT_ID=your-client-id
COMMERCETOOLS_CLIENT_SECRET=your-client-secret
COMMERCETOOLS_SCOPE=manage_project:your-project-key
COMMERCETOOLS_REGION=us-central1.gcp

# Standard Commercetools API Client input for one-time project provisioning
CTP_PROJECT_KEY=your-project-key
CTP_CLIENT_SECRET=your-bootstrap-client-secret
CTP_CLIENT_ID=your-bootstrap-client-id
CTP_AUTH_URL=https://auth.us-central1.gcp.commercetools.com
CTP_API_URL=https://api.us-central1.gcp.commercetools.com
CTP_SCOPES=manage_project_settings:your-project-key manage_api_clients:your-project-key

# Connect deployment: a still-valid management client uses these CTP_SCOPES.
# Add manage_connectors_deployments:<projectKey> and manage_api_clients:<projectKey>.
# Proxy runtime credentials are created separately with only manage_subscriptions.
# Optional provisioning input: reuse an existing API receiver signing secret.
# COMMERCETOOLS_WEBHOOK_SECRET=<existing-api-runtime-secret>

# API runtime only: copy the generated signing secret from commerce connect deploy --output.
COMMERCETOOLS_WEBHOOK_SECRET=
# API -> web catalog invalidation. Vercel Services can inject WEB_INTERNAL_URL.
# Otherwise, set the full fallback endpoint in API. Share the secret with web.
REVALIDATION_ENDPOINT=https://web.example.com/api/revalidate
REVALIDATION_SECRET=
